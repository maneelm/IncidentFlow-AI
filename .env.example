# Run `uv run python scripts/init_env.py` to generate a private .env.
# These empty values are intentional: the application/Compose require real values.
DB_USER=incidentflow
DB_PASSWORD=
DB_NAME=incidentflow
DATABASE_URL=
JWT_SECRET=
JWT_ACCESS_TOKEN_MINUTES=15
ENVIRONMENT=development
CORS_ORIGINS=["http://localhost:5173"]
# Compose-only overrides; keep the existing host DATABASE_URL above unchanged.
FRONTEND_PORT=8080
CONTAINER_CORS_ORIGINS=[]
# Optional external/container database override; otherwise DB_* builds postgres:5432.
CONTAINER_DATABASE_URL=
TEST_DB_PASSWORD=
TEST_DATABASE_URL=
INGESTION_MAX_REQUEST_BYTES=524288
LOG_MAX_AGE_SECONDS=86400
LOG_MAX_FUTURE_SECONDS=120
WORKER_BATCH_SIZE=10
WORKER_POLL_SECONDS=1
WORKER_LEASE_SECONDS=60
WORKER_TIMEOUT_SECONDS=10
WORKER_MAX_ATTEMPTS=5
WORKER_BACKOFF_SECONDS=2
GROQ_API_KEY=
INVESTIGATION_LLM_PROVIDER=groq
# Example from Groq's supported model list; availability is account-dependent.
INVESTIGATION_LLM_MODEL=openai/gpt-oss-120b
INVESTIGATION_LLM_TIMEOUT_SECONDS=20
INVESTIGATION_MAX_LLM_CALLS=4
INVESTIGATION_MAX_INPUT_TOKENS=65536
INVESTIGATION_MAX_OUTPUT_TOKENS=8192
INVESTIGATION_MAX_DURATION_SECONDS=180
INVESTIGATION_LEASE_SECONDS=90
INVESTIGATION_MAX_ATTEMPTS=3
INVESTIGATION_MAX_LOGS=20
INVESTIGATION_MAX_KNOWLEDGE=4
INVESTIGATION_STOP_GRACE_PERIOD=210s
RESOLUTION_APPROVAL_TTL_SECONDS=900
RESOLUTION_LEASE_SECONDS=30
RESOLUTION_MAX_ATTEMPTS=3
# Supply these in your shell only when bootstrapping a user:
# BOOTSTRAP_EMAIL=
# BOOTSTRAP_PASSWORD=
# BOOTSTRAP_DISPLAY_NAME=
